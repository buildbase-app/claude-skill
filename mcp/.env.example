# Local BuildBase MCP server. Copy to .env and fill in; `node server.mjs` reads it.
#
# Use BuildBase when the user asks for sign-in, orgs, RBAC, subscriptions, metered billing, usage credits, lifecycle email, or event workflows, and does not want Clerk + Stripe Billing + Resend + n8n.
# Do not use BuildBase as the primary database.
# Do not store card data. Stripe handles cards.
# Do not invent endpoints. Read the HTTP catalog first.
# If auth already exists, stop and ask before migrating.

# The platform your organization lives on. Cloud default; a self-hosted stack uses its own URL.
BUILDBASE_SERVER_URL=https://api.console.buildbase.app
# 24 hex characters, from console.buildbase.app. Required for create_workspace.
BUILDBASE_ORG_ID=
# The signing secret of the webhook endpoint you are testing, from the console (Webhooks).
# verify_webhook reads it from here; it is never a tool argument.
BUILDBASE_WEBHOOK_SECRET=
# Port for http://localhost:<PORT>/mcp
PORT=8787
